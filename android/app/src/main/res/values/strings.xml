    <!-- Blocking screen -->
    <string name="blocking_info_title">Blocking Info</string>
    <string name="blocking_info_body">Website — Websites you add here are blocked right away, no matter which blocklists you use. You can pause blocking for a site or remove it entirely.\n\nBlocklists — We use AdGuard\'s DNS servers (with Cloudflare and Google as automatic fallbacks), which blocks most ads by default. You can also add your own blocklist URLs here.</string>
    <string name="tab_blocklists">Blocklists</string>

